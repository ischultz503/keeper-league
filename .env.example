# Copy to .env and fill in. .env is git-ignored and never enters the image.
#
#   cp .env.example .env
#
# Generate a secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# --- Required everywhere -----------------------------------------------------

# Signs sessions and password-reset tokens. Different value per environment;
# changing it logs everyone out. There is no fallback in settings.py: a server
# started without this refuses to boot rather than quietly using a known key.
DJANGO_SECRET_KEY=

# --- Local development -------------------------------------------------------

# Debug defaults to OFF. Turn it on locally; never on the server.
DJANGO_DEBUG=true

# With DEBUG on and no hosts listed, settings.py falls back to localhost, so
# this can stay empty for local work.
DJANGO_ALLOWED_HOSTS=

# --- Server (docker compose) -------------------------------------------------
# On the EC2 box, DJANGO_DEBUG is absent or false and these are filled in.
#
# DJANGO_ALLOWED_HOSTS=keepers.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://keepers.example.com
# DOMAIN=keepers.example.com
# ACME_EMAIL=you@example.com

# --- Optional ----------------------------------------------------------------

# Overridden by docker-compose to the bind-mounted path; leave unset locally.
# DJANGO_DB_PATH=

# gunicorn process count. Default 3.
# GUNICORN_WORKERS=3

# FantasyPros ADP import (management command only, not needed to serve).
FANTASYPROS_API_KEY=
